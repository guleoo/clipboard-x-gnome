{
  "uuid": "@uuid@",
  "name": "Clipboard X Gnome",
  "description": "Clipboard history, text tools, device synchronization, color picking and screenshots. This extension accesses clipboard content and only sends it to a user-configured synchronization server according to user settings.",
  "shell-version": ["50", "51"],
  "settings-schema": "@schema@",
  "gettext-domain": "clipboard-x",
  "version-name": "@version@",
  "url": "https://github.com/guleoo/clipboard-x-gnome"
}
