<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-Bus Object Introspection 1.0//EN"
  "https://dbus.freedesktop.org/doc/introspect.dtd">
<node>
  <interface name="io.github.guleo.ClipboardX.Sync1">
    <property name="ApiVersion" type="u" access="read"/>
    <property name="ImplementationName" type="s" access="read"/>
    <property name="ImplementationVersion" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="SupportedMimeTypes" type="as" access="read"/>
    <property name="MaxItemBytes" type="t" access="read"/>
    <property name="MaxPreviewBytes" type="t" access="read"/>

    <method name="GetStatus">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="status" type="a{sv}" direction="out"/>
    </method>

    <method name="RegisterDevice">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="profile" type="a{sv}" direction="in"/>
    </method>

    <method name="ListDevices">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="devices" type="aa{sv}" direction="out"/>
    </method>

    <method name="GetConfiguration">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="configuration" type="a{sv}" direction="out"/>
    </method>

    <method name="UpdateConfiguration">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="changes" type="a{sv}" direction="in"/>
      <arg name="configuration" type="a{sv}" direction="out"/>
    </method>

    <method name="ListChannels">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="channels" type="aa{sv}" direction="out"/>
    </method>

    <method name="TestConnection">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>

    <method name="Publish">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="item" type="a{sv}" direction="in"/>
      <arg name="previews" type="a(sa{sv}h)" direction="in"/>
      <arg name="contents" type="a(sa{sv}h)" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="itemId" type="s" direction="out"/>
      <arg name="transferId" type="s" direction="out"/>
    </method>

    <method name="GetChanges">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="cursor" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="nextCursor" type="s" direction="out"/>
      <arg name="changes" type="aa{sv}" direction="out"/>
      <arg name="hasMore" type="b" direction="out"/>
    </method>

    <method name="GetItem">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="itemId" type="s" direction="in"/>
      <arg name="item" type="a{sv}" direction="out"/>
      <arg name="previews" type="a(sa{sv}h)" direction="out"/>
    </method>

    <method name="RequestContent">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="itemId" type="s" direction="in"/>
      <arg name="contentIds" type="as" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="transferId" type="s" direction="out"/>
    </method>

    <method name="OpenContent">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="itemId" type="s" direction="in"/>
      <arg name="contentId" type="s" direction="in"/>
      <arg name="metadata" type="a{sv}" direction="out"/>
      <arg name="content" type="h" direction="out"/>
    </method>

    <method name="CancelTransfer">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="transferId" type="s" direction="in"/>
    </method>

    <method name="Acknowledge">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="itemId" type="s" direction="in"/>
      <arg name="result" type="s" direction="in"/>
      <arg name="message" type="s" direction="in"/>
    </method>

    <method name="GetTransfer">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="transferId" type="s" direction="in"/>
      <arg name="transfer" type="a{sv}" direction="out"/>
    </method>

    <method name="ListTransfers">
      <arg name="deviceId" type="s" direction="in"/>
      <arg name="filter" type="a{sv}" direction="in"/>
      <arg name="transfers" type="aa{sv}" direction="out"/>
    </method>

    <signal name="StatusChanged">
      <arg name="status" type="a{sv}"/>
    </signal>

    <signal name="DeviceChanged">
      <arg name="device" type="a{sv}"/>
    </signal>

    <signal name="DeviceRemoved">
      <arg name="deviceId" type="s"/>
      <arg name="reason" type="s"/>
    </signal>

    <signal name="ChangesAvailable">
      <arg name="latestCursor" type="s"/>
    </signal>

    <signal name="TransferChanged">
      <arg name="transfer" type="a{sv}"/>
    </signal>

    <signal name="ConfigurationChanged">
      <arg name="configuration" type="a{sv}"/>
    </signal>

    <signal name="ChannelsChanged">
      <arg name="revision" type="t"/>
    </signal>
  </interface>
</node>
