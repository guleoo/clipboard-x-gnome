{
  "name": "clipboard-x-gnome",
  "version": "1.0.4",
  "author": {
    "name": "guleoo",
    "url": "https://github.com/guleoo"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/guleoo/clipboard-x-gnome",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "meson test -C build --print-errorlogs",
    "build": "meson compile -C build",
    "test:shell": "gnome-shell-test-tool --headless --extension build/clipboard-x-gnome_$(node -p \"require('./package.json').version\").zip tests/ui/shell.smoke.js",
    "test:terminal": "dbus-run-session -- env GTK_A11Y=none NO_AT_BRIDGE=1 gnome-shell-test-tool --headless --extension build/clipboard-x-gnome_$(node -p \"require('./package.json').version\").zip tests/ui/terminal.smoke.js"
  }
}
